#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# tools/ci-build -- build every Alire crate in the repo, as CI does.
#   tools/ci-build             all crates under crates/, book/,
#                              tools/ and tests/
#   tools/ci-build book/ch01_hello_photon ...
# Book projects cross-compiled for a board (they depend on
# gnat_arm_elf) also get a size report; RP2350 ones, with picotool,
# a UF2.
# Host crates (gnat_native) and libraries are only built; the host
# tests under tests/ also run. Without arguments, it also checks that
# every memory.ld matches the memory.toml it was generated from and,
# with svd2ada on PATH, that every gen/ directory is current.
set -euo pipefail
cd "$(dirname "$0")/.."
root=$PWD

if [ $# -gt 0 ]; then
  crates=("$@")
else
  mapfile -t crates < <(find crates book tools tests \
    -mindepth 2 -maxdepth 2 \
    -name alire.toml -printf '%h\n' | sort)
fi

fail=0
for c in "${crates[@]}"; do
  echo "::group::alr build $c"
  if (cd "$c" && alr -n build); then
    echo "ok: $c"
  else
    echo "FAILED: $c"; fail=1
  fi
  echo "::endgroup::"
  case "$c" in
    tests/*)
      exe=$(sed -n 's/^executables *= *\[ *"\([^"]*\)".*/\1/p' \
        "$c/alire.toml")
      if "$c/bin/$exe"; then
        echo "ok: $c passed"
      else
        echo "FAILED: $c tests"; fail=1
      fi
      ;;
  esac
  grep -q '^gnat_arm_elf' "$c/alire.toml" || continue
  case "$c" in
    book/*)
      exe=$(sed -n 's/^executables *= *\[ *"\([^"]*\)".*/\1/p' \
        "$c/alire.toml")
      elf="$c/bin/$exe"
      [ -f "$elf" ] || continue
      (cd "$c" && alr -n exec -- arm-eabi-size "bin/$exe") || true
      # A UF2 only for the RP2350 (the NUCLEO ports flash the ELF)
      grep -q '^light[a-z_]*rp2350' "$c/alire.toml" || continue
      if command -v picotool >/dev/null; then
        "$root/tools/flash" uf2 "$c"
      fi
      ;;
  esac
done

if [ $# -eq 0 ]; then
  for toml in crates/*/ld/*/memory.toml; do
    if tools/memgen/bin/memgen --check "$toml" "${toml%.toml}.ld"
    then
      echo "ok: ${toml%.toml}.ld is current"
    else
      fail=1
    fi
  done
  if command -v svd2ada >/dev/null; then
    tools/svd-gen --check || fail=1
  fi
fi
exit $fail
