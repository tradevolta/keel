#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# tools/svd-gen -- regenerate the L1 register crates with svd2ada.
#   tools/svd-gen            regenerate every gen/ directory
#   tools/svd-gen --check    regenerate into a temporary directory and
#                            fail if any checked-in file differs
# Each SVD is pinned by URL and SHA-256. The SVD files themselves are
# not checked in; they are downloaded once into the cache directory.
# svd2ada comes from PATH ("alr install svd2ada=0.1.0").
set -euo pipefail
cd "$(dirname "$0")/.."
cache=${XDG_CACHE_HOME:-$HOME/.cache}/keel-svd
mkdir -p "$cache"
check=0
[ "${1:-}" = "--check" ] && check=1

# crate | root package | SVD URL | SHA-256
targets=(
"keel_rp2350_svd|RP2350_SVD|https://raw.githubusercontent.com/\
raspberrypi/pico-sdk/2.3.1/src/rp2350/hardware_regs/RP2350.svd|\
e75578fbc6aee06ddf875fd2fe71d7ab59fc19fb406c7eed58849a6c8cf491fd"
"keel_stm32g4_svd|STM32G4_SVD|https://raw.githubusercontent.com/\
modm-io/cmsis-svd-stm32/ce4b873ae4a471cf28d7a7c9c69ded252d949672/\
stm32g4/STM32G474.svd|\
b9d75d8f197df0ecd11d60885862da166f31878cf18d1b5c5e126ab675130281"
)
options=(--boolean)

fail=0
for t in "${targets[@]}"; do
  IFS='|' read -r crate pkg url sha <<< "$t"
  # Keep the file's own name: svd2ada writes it into every header.
  mkdir -p "$cache/$sha"
  svd="$cache/$sha/${url##*/}"
  if [ ! -f "$svd" ]; then
    curl -fsSL --retry 3 -o "$svd.part" "$url"
    mv "$svd.part" "$svd"
  fi
  if ! echo "$sha  $svd" | sha256sum -c --status; then
    echo "svd-gen: $url does not match its SHA-256"; exit 1
  fi
  out=crates/$crate/gen
  [ $check -eq 1 ] && out=$(mktemp -d)
  rm -rf "${out:?}"/*.ads
  mkdir -p "$out"
  svd2ada "${options[@]}" -p "$pkg" -o "$out" "$svd" > /dev/null
  cat > "$out/PROVENANCE" <<END
Generated by tools/svd-gen. Do not edit the files in this directory.
generator: svd2ada 0.1.0 (Alire index, AdaCore/svd2ada 6eb0b591)
options:   ${options[*]} -p $pkg
svd:       $url
sha256:    $sha
END
  if [ $check -eq 1 ]; then
    if diff -r -q "crates/$crate/gen" "$out" > /dev/null; then
      echo "ok: crates/$crate/gen is current"
    else
      echo "svd-gen: crates/$crate/gen differs from svd2ada output"
      fail=1
    fi
    rm -rf "$out"
  else
    echo "$crate: $(ls "$out"/*.ads | wc -l) specs in $out"
  fi
done
exit $fail
