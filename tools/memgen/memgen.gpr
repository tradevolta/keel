with "config/memgen_config.gpr";

project Memgen is
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Memgen_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("memgen.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Memgen_Config.Ada_Compiler_Switches & ("-gnat2022");
   end Compiler;
end Memgen;
