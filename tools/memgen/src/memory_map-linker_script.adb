with Ada.Characters.Latin_1;

function Memory_Map.Linker_Script (B : Board) return String is
   LF : constant Character := Ada.Characters.Latin_1.LF;
   Text : Unbounded_String :=
     To_Unbounded_String
       ("/* SPDX-License-Identifier: Apache-2.0 */" & LF
        & "/* Generated by tools/memgen from memory.toml: do not edit."
        & LF & "   " & To_String (B.Description) & " */" & LF
        & "MEMORY" & LF & "{" & LF);
begin
   for R of B.Regions loop
      Append (Text, "  " & To_String (R.Name)
        & " (" & To_String (R.Attributes) & ") : ORIGIN = "
        & Hex (R.Origin) & ", LENGTH = " & Image (R.Size) & LF);
   end loop;
   Append (Text, "}" & LF & LF
     & "REGION_ALIAS(""stack"", "
     & To_String (B.Regions (B.Stack_Region).Name) & ");" & LF
     & "__keel_stack_size = " & Image (B.Stack_Size) & ";" & LF);
   return To_String (Text);
end Memory_Map.Linker_Script;
