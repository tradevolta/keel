PROVIDE(keel_isr_56 = keel_default_handler);
PROVIDE(keel_isr_57 = keel_default_handler);
PROVIDE(keel_isr_58 = keel_default_handler);
PROVIDE(keel_isr_59 = keel_default_handler);
PROVIDE(keel_isr_60 = keel_default_handler);
PROVIDE(keel_isr_61 = keel_default_handler);
PROVIDE(keel_isr_62 = keel_default_handler);
PROVIDE(keel_isr_63 = keel_default_handler);
PROVIDE(keel_isr_64 = keel_default_handler);
PROVIDE(keel_isr_65 = keel_default_handler);
PROVIDE(keel_isr_66 = keel_default_handler);
PROVIDE(keel_isr_67 = keel_default_handler);
PROVIDE(keel_isr_68 = keel_default_handler);
