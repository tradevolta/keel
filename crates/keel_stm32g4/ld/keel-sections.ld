/* SPDX-License-Identifier: Apache-2.0 */
/* Keel L0 linker script for the STM32G4 (Startup = "keel").
   The board's memory.ld, generated by tools/memgen, names the
   regions flash, sram and ccmsram, and aliases one of them as
   stack. The RP2350's script, without the boot block. */
INCLUDE memory.ld

/* Pull keel-startup.o out of the library, then start there. */
EXTERN(keel_reset_handler)
ENTRY(keel_reset_handler)

/* Flash: the vector table first, then code and constants. */
SECTIONS
{
  /* After reset the core reads its stack pointer and reset vector
     from the start of flash, which the boot pins map at 0. */
  .text :
  {
    KEEP(*(.keel.vectors))
    *(.text .text.*)
    *(.rodata .rodata.*)
    . = ALIGN(4);
    __keel_text_end = .;
  } > flash
  .ARM.exidx :
  {
    *(.ARM.exidx*)
  } > flash
}

/* SRAM: code that runs from RAM, .data, then .bss. */
SECTIONS
{
  .time_critical :
  {
    __keel_data_start = .;
    *(.time_critical .time_critical.*)
    . = ALIGN(4);
    __keel_time_critical_end = .;
  } > sram AT > flash
  __keel_data_load = LOADADDR(.time_critical);
  .data :
  {
    *(.data .data.*)
    . = ALIGN(4);
    __keel_data_end = .;
  } > sram AT > flash
  ASSERT(LOADADDR(.data) - __keel_data_load
         == ADDR(.data) - __keel_data_start,
         "keel: .time_critical and .data must be one block")
  .bss (NOLOAD) :
  {
    __keel_bss_start = .;
    *(.bss .bss.* COMMON)
    . = ALIGN(4);
    __keel_bss_end = .;
  } > sram
}

/* The main stack, in the region memory.toml chose */
SECTIONS
{
  .stack (NOLOAD) :
  {
    . = ALIGN(8);
    __keel_stack_start = .;
    . += __keel_stack_size;
    __keel_stack_end = .;
  } > stack
}
