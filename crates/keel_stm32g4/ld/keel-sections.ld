PROVIDE(keel_isr_81 = keel_default_handler);
PROVIDE(keel_isr_82 = keel_default_handler);
PROVIDE(keel_isr_83 = keel_default_handler);
PROVIDE(keel_isr_84 = keel_default_handler);
PROVIDE(keel_isr_85 = keel_default_handler);
PROVIDE(keel_isr_86 = keel_default_handler);
PROVIDE(keel_isr_87 = keel_default_handler);
PROVIDE(keel_isr_88 = keel_default_handler);
PROVIDE(keel_isr_89 = keel_default_handler);
PROVIDE(keel_isr_90 = keel_default_handler);
PROVIDE(keel_isr_91 = keel_default_handler);
PROVIDE(keel_isr_92 = keel_default_handler);
PROVIDE(keel_isr_93 = keel_default_handler);
PROVIDE(keel_isr_94 = keel_default_handler);
PROVIDE(keel_isr_95 = keel_default_handler);
PROVIDE(keel_isr_96 = keel_default_handler);
PROVIDE(keel_isr_97 = keel_default_handler);
PROVIDE(keel_isr_98 = keel_default_handler);
PROVIDE(keel_isr_99 = keel_default_handler);
PROVIDE(keel_isr_100 = keel_default_handler);
PROVIDE(keel_isr_101 = keel_default_handler);

/* Flash: the vector table first, then code and constants. */
SECTIONS
{
  /* After reset the core reads its stack pointer and reset vector
     from the start of flash, which the boot pins map at 0. */
  .text :
  {
    KEEP(*(.keel.vectors))
    *(.text .text.*)
    *(.rodata .rodata.*)
    . = ALIGN(4);
    __keel_text_end = .;
  } > flash
  .ARM.exidx :
  {
    *(.ARM.exidx*)
  } > flash
}

/* SRAM: code that runs from RAM, .data, then .bss. */
SECTIONS
{
  .time_critical :
  {
    __keel_data_start = .;
    *(.time_critical .time_critical.*)
    . = ALIGN(4);
    __keel_time_critical_end = .;
  } > sram AT > flash
  __keel_data_load = LOADADDR(.time_critical);
  .data :
  {
    *(.data .data.*)
    . = ALIGN(4);
    __keel_data_end = .;
  } > sram AT > flash
  ASSERT(LOADADDR(.data) - __keel_data_load
         == ADDR(.data) - __keel_data_start,
         "keel: .time_critical and .data must be one block")
  .bss (NOLOAD) :
  {
    __keel_bss_start = .;
    *(.bss .bss.* COMMON)
    . = ALIGN(4);
    __keel_bss_end = .;
  } > sram
}

/* The main stack, in the region memory.toml chose */
SECTIONS
{
  .stack (NOLOAD) :
  {
    . = ALIGN(8);
    __keel_stack_start = .;
    . += __keel_stack_size;
    __keel_stack_end = .;
  } > stack
}
