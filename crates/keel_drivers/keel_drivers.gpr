--  SPDX-License-Identifier: Apache-2.0
--  Device drivers. Each depends only on keel_core's signatures, never
--  on a chip, so the same driver runs on the host's fakes, the RP2350
--  and the STM32G4.
with "config/keel_drivers_config.gpr";
with "keel_core.gpr";

project Keel_Drivers is
   for Library_Name use "Keel_Drivers";
   for Library_Kind use "static";
   for Source_Dirs use ("src/", "config/");
   --  Built for the host and for the boards, like keel_core
   for Object_Dir use "obj/" & Project'Target & "/"
     & Keel_Drivers_Config.Build_Profile;
   for Library_Dir use "lib/" & Project'Target;
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        Keel_Drivers_Config.Ada_Compiler_Switches & ("-gnat2022");
   end Compiler;
end Keel_Drivers;
