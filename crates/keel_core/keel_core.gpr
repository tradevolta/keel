with "config/keel_core_config.gpr";
project Keel_Core is

   for Library_Name use "Keel_Core";
   for Library_Version use
     Project'Library_Name & ".so." & Keel_Core_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   --  Keel_Core is built for the host and for the RP2350, so each
   --  target gets its own object and library directories.
   for Object_Dir use "obj/" & Project'Target & "/"
     & Keel_Core_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib/" & Project'Target;

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("KEEL_CORE_LIBRARY_TYPE",
               external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use
        Keel_Core_Config.Ada_Compiler_Switches & ("-gnat2022");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Keel_Core;
