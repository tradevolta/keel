with "config/keel_rp2350_config.gpr";
with "runtime_build.gpr";
with "keel_core.gpr";

project Keel_RP2350 is
   for Target use Runtime_Build'Target;
   for Runtime ("Ada") use Runtime_Build'Runtime ("Ada");

   for Library_Name use "Keel_RP2350";
   for Library_Kind use "static";
   for Library_Dir use "lib";
   for Object_Dir use "obj/" & Keel_RP2350_Config.Build_Profile;
   for Create_Missing_Dirs use "True";

   --  Startup = "keel": Keel's vector table, boot block and reset
   --  handler, linked with Keel's script. Startup = "runtime": the
   --  runtime's own startup and linker script, as in Chapters 1-3.
   Linker_Switches := ();
   case Keel_RP2350_Config.Startup is
      when "keel" =>
         for Source_Dirs use ("src/", "src/startup/", "config/");
         Linker_Switches :=
           ("-L" & Project'Project_Dir & "ld/pico2w",
            "-T" & Project'Project_Dir & "ld/keel-sections.ld");
      when "runtime" =>
         for Source_Dirs use ("src/", "config/");
         Linker_Switches := Runtime_Build.Linker_Switches;
   end case;

   package Compiler is
      for Default_Switches ("Ada") use
        Keel_RP2350_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-ffunction-sections", "-fdata-sections");
   end Compiler;
end Keel_RP2350;
