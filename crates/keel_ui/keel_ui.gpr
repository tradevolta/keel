--  SPDX-License-Identifier: Apache-2.0
--  A small 2D graphics library: colors, rectangles, a canvas that
--  is a DMA buffer with a place on the screen, lines, discs, bitmap
--  text and widgets. It depends only on keel_core, so it draws the
--  same pixels on the host, the RP2350 and the STM32G4.
with "config/keel_ui_config.gpr";
with "keel_core.gpr";

project Keel_UI is
   for Library_Name use "Keel_UI";
   for Library_Kind use "static";
   for Source_Dirs use ("src/", "config/");
   --  Built for the host and for the boards, like keel_core
   for Object_Dir use "obj/" & Project'Target & "/"
     & Keel_UI_Config.Build_Profile;
   for Library_Dir use "lib/" & Project'Target;
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        Keel_UI_Config.Ada_Compiler_Switches & ("-gnat2022");
   end Compiler;
end Keel_UI;
