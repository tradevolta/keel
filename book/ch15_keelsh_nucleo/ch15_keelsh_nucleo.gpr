with "config/ch15_keelsh_nucleo_config.gpr";
with "runtime_build.gpr";
with "keel_core.gpr";
with "keel_cli.gpr";
with "keel_log.gpr";
with "keel_stm32g4.gpr";
with "keel_stm32g4_svd.gpr";

project Ch15_Keelsh_Nucleo is
   for Target use Runtime_Build'Target;
   for Runtime ("Ada") use Runtime_Build'Runtime ("Ada");

   --  The Pico project's shell and commands; only the board is new
   for Source_Dirs use
     ("../ch15_keelsh/src/common/", "src/", "config/");
   for Object_Dir use
     "obj/" & Ch15_Keelsh_Nucleo_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("keelsh.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Ch15_Keelsh_Nucleo_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-ffunction-sections", "-fdata-sections");
      for Local_Configuration_Pragmas use "gnat.adc";
   end Compiler;

   package Linker is
      for Switches ("Ada") use
        Keel_STM32G4.Linker_Switches & ("-Wl,--gc-sections");
   end Linker;
end Ch15_Keelsh_Nucleo;
