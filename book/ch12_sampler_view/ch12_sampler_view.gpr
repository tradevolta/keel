with "config/ch12_sampler_view_config.gpr";

project Ch12_Sampler_View is
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use
     "obj/" & Ch12_Sampler_View_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("sampler_view.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Ch12_Sampler_View_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-gnata");
   end Compiler;
end Ch12_Sampler_View;
