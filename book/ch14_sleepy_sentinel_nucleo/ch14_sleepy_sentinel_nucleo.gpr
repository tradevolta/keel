with "config/ch14_sleepy_sentinel_nucleo_config.gpr";
with "runtime_build.gpr";
with "keel_core.gpr";
with "keel_drivers.gpr";
with "keel_stm32g4.gpr";
with "keel_stm32g4_svd.gpr";

project Ch14_Sleepy_Sentinel_Nucleo is
   for Target use Runtime_Build'Target;
   for Runtime ("Ada") use Runtime_Build'Runtime ("Ada");

   --  The Pico project's program and log; only the board is new
   for Source_Dirs use
     ("../ch14_sleepy_sentinel/src/common/",
      "../ch14_sleepy_sentinel/src/shared/", "src/", "config/");
   for Object_Dir use
     "obj/" & Ch14_Sleepy_Sentinel_Nucleo_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("sleepy_sentinel.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Ch14_Sleepy_Sentinel_Nucleo_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-ffunction-sections", "-fdata-sections");
      for Local_Configuration_Pragmas use "gnat.adc";
   end Compiler;

   package Linker is
      for Switches ("Ada") use
        Keel_STM32G4.Linker_Switches & ("-Wl,--gc-sections");
   end Linker;
end Ch14_Sleepy_Sentinel_Nucleo;
