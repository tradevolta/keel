with "config/ch13_thermo_strip_config.gpr";
with "runtime_build.gpr";
with "keel_core.gpr";
with "keel_drivers.gpr";
with "keel_rp2350.gpr";
with "keel_rp2350_svd.gpr";

project Ch13_Thermo_Strip is
   for Target use Runtime_Build'Target;
   for Runtime ("Ada") use Runtime_Build'Runtime ("Ada");

   --  common/ is the program, pico2w/ the board, shared/ the colours,
   --  which the host test compiles too
   for Source_Dirs use
     ("src/common/", "src/pico2w/", "src/shared/", "config/");
   for Object_Dir use "obj/" & Ch13_Thermo_Strip_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("thermo_strip.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Ch13_Thermo_Strip_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-ffunction-sections", "-fdata-sections");
      --  The driver rule, checked by the compiler (gnat.adc).
      for Local_Configuration_Pragmas use "gnat.adc";
   end Compiler;

   package Linker is
      for Switches ("Ada") use
        Keel_RP2350.Linker_Switches & ("-Wl,--gc-sections");
   end Linker;
end Ch13_Thermo_Strip;
