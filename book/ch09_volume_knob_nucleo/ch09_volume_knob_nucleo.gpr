with "config/ch09_volume_knob_nucleo_config.gpr";
with "runtime_build.gpr";
with "keel_core.gpr";
with "keel_stm32g4.gpr";
with "keel_stm32g4_svd.gpr";

project Ch09_Volume_Knob_Nucleo is
   for Target use Runtime_Build'Target;
   for Runtime ("Ada") use Runtime_Build'Runtime ("Ada");

   --  The main, Board's spec and Crash are the Pico 2 W
   --  project's, unchanged; only the board body is new.
   for Source_Dirs use
     ("../ch09_volume_knob/src/common/", "src/", "config/");
   for Object_Dir use
     "obj/" & Ch09_Volume_Knob_Nucleo_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("volume_knob.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Ch09_Volume_Knob_Nucleo_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-ffunction-sections", "-fdata-sections");
      for Local_Configuration_Pragmas use "gnat.adc";
   end Compiler;

   package Linker is
      for Switches ("Ada") use
        Keel_STM32G4.Linker_Switches & ("-Wl,--gc-sections");
   end Linker;
end Ch09_Volume_Knob_Nucleo;
