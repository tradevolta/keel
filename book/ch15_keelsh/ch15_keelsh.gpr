with "config/ch15_keelsh_config.gpr";
with "runtime_build.gpr";
with "keel_core.gpr";
with "keel_cli.gpr";
with "keel_log.gpr";
with "keel_rp2350.gpr";
with "keel_rp2350_svd.gpr";

project Ch15_Keelsh is
   for Target use Runtime_Build'Target;
   for Runtime ("Ada") use Runtime_Build'Runtime ("Ada");

   --  common/ is the shell and its commands, which the NUCLEO build
   --  and the host test compile too; pico2w/ is the board
   for Source_Dirs use ("src/common/", "src/pico2w/", "config/");
   for Object_Dir use "obj/" & Ch15_Keelsh_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("keelsh.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Ch15_Keelsh_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-ffunction-sections", "-fdata-sections");
      --  The driver rule, checked by the compiler (gnat.adc).
      for Local_Configuration_Pragmas use "gnat.adc";
   end Compiler;

   package Linker is
      for Switches ("Ada") use
        Keel_RP2350.Linker_Switches & ("-Wl,--gc-sections");
   end Linker;
end Ch15_Keelsh;
