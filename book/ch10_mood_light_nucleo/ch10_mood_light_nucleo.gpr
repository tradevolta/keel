with "config/ch10_mood_light_nucleo_config.gpr";
with "runtime_build.gpr";
with "keel_core.gpr";
with "keel_stm32g4.gpr";
with "keel_stm32g4_svd.gpr";

project Ch10_Mood_Light_Nucleo is
   for Target use Runtime_Build'Target;
   for Runtime ("Ada") use Runtime_Build'Runtime ("Ada");

   --  Only the sweep: src/pot/ reads the RP2350's ADC
   type Angle_Kind is ("sweep");
   Angle : Angle_Kind := external ("ANGLE", "sweep");

   --  The main, Board's spec, the colors and the angle source are
   --  the Pico 2 W project's, unchanged; only the board body is new.
   for Source_Dirs use
     ("../ch10_mood_light/src/common/",
      "../ch10_mood_light/src/" & Angle & "/", "src/", "config/");
   for Object_Dir use "obj/" & Angle & "/"
     & Ch10_Mood_Light_Nucleo_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("mood_light.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Ch10_Mood_Light_Nucleo_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-ffunction-sections", "-fdata-sections");
      for Local_Configuration_Pragmas use "gnat.adc";
   end Compiler;

   package Linker is
      for Switches ("Ada") use
        Keel_STM32G4.Linker_Switches & ("-Wl,--gc-sections");
   end Linker;
end Ch10_Mood_Light_Nucleo;
