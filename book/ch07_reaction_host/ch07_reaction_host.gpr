with "config/ch07_reaction_host_config.gpr";
with "keel_host.gpr";

project Ch07_Reaction_Host is
   --  The game, the panel and the main are the Pico 2 W project's;
   --  the board body drives fake pins from a script.
   for Source_Dirs use
     ("../ch07_reaction_time/src/common/", "src/", "config/");
   for Object_Dir use
     "obj/" & Ch07_Reaction_Host_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("reaction_time.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Ch07_Reaction_Host_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-gnata");
   end Compiler;
end Ch07_Reaction_Host;
