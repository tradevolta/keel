{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pico 2 W: single_step (OpenOCD + Debug Probe)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/bin/single_step",
      "servertype": "openocd",
      "serverpath": "openocd",
      "gdbPath": "arm-eabi-gdb",
      "configFiles": ["interface/cmsis-dap.cfg", "target/rp2350.cfg"],
      "openOCDLaunchCommands": ["adapter speed 5000"],
      "runToEntryPoint": "_ada_single_step",
      "preLaunchTask": "alr build"
    }
  ]
}
