with "config/ch02_single_step_config.gpr";
with "runtime_build.gpr";
with "ravenscar_build.gpr";

project Ch02_Single_Step is
   for Target use Runtime_Build'Target;
   for Runtime ("Ada") use Runtime_Build'Runtime ("Ada");

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use
     "obj/" & Ch02_Single_Step_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("single_step.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Ch02_Single_Step_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-ffunction-sections", "-fdata-sections");
   end Compiler;

   package Linker is
      for Switches ("Ada") use
        Runtime_Build.Linker_Switches &
        ("-Wl,--gc-sections",
         "-Wl,-Map=" & Project'Project_Dir & "bin/single_step.map");
   end Linker;

   --  Where an IDE's debugger finds the GDB server (OpenOCD).
   package IDE is
      for Program_Host use "localhost:3333";
   end IDE;
end Ch02_Single_Step;
