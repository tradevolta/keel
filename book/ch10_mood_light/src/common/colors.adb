package body Colors is
   use type Keel.PWM.Duty;

   function Wheel (H : Hue) return RGB is
      --  Position within the current third, 0 .. 119
      Step : constant Natural := Natural (H) mod 120;
      Up   : constant Brightness := 255 * Step / 120;
      Down : constant Brightness := 255 - Up;
   begin
      case H is
         when 0 .. 119 =>
            return (Red => Down, Green => Up, Blue => 0);
         when 120 .. 239 =>
            return (Red => 0, Green => Down, Blue => Up);
         when 240 .. 359 =>
            return (Red => Up, Green => 0, Blue => Down);
      end case;
   end Wheel;

   --  round (65_536 * (B / 255) ** 2.2), worked out once on a
   --  computer: the eye's response is close to a power law, so equal
   --  steps of B look like equal steps of brightness
