     ];

   --  The smallest duty, 1/65536
   One_Step : constant Keel.PWM.Duty := Keel.PWM.Duty'Small;

   function Gamma (B : Brightness) return Keel.PWM.Duty is
     (One_Step * Table (B));
end Colors;
