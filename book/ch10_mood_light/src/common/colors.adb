      0, 0, 2, 4, 7, 11, 17, 24,
      32, 42, 53, 65, 79, 94, 111, 129,
      148, 169, 192, 216, 242, 270, 299, 330,
      362, 396, 432, 469, 508, 549, 591, 635,
      681, 729, 779, 830, 883, 938, 995, 1053,
