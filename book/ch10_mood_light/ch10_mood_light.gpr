with "config/ch10_mood_light_config.gpr";
with "runtime_build.gpr";
with "keel_core.gpr";
with "keel_rp2350.gpr";
with "keel_rp2350_svd.gpr";

project Ch10_Mood_Light is
   for Target use Runtime_Build'Target;
   for Runtime ("Ada") use Runtime_Build'Runtime ("Ada");

   --  Where the servo's angle comes from: "sweep", a stand-in that
   --  sweeps by itself, or "pot", a potentiometer on the ADC
   --  (Chapter 11)
   type Angle_Kind is ("sweep", "pot");
   Angle : Angle_Kind := external ("ANGLE", "sweep");

   --  common/ is the light, pico2w/ the board
   for Source_Dirs use
     ("src/common/", "src/pico2w/", "src/" & Angle & "/", "config/");
   for Object_Dir use "obj/" & Angle & "/"
     & Ch10_Mood_Light_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("mood_light.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Ch10_Mood_Light_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-ffunction-sections", "-fdata-sections");
      --  The driver rule, checked by the compiler (gnat.adc).
      for Local_Configuration_Pragmas use "gnat.adc";
   end Compiler;

   package Linker is
      for Switches ("Ada") use
        Keel_RP2350.Linker_Switches & ("-Wl,--gc-sections");
   end Linker;
end Ch10_Mood_Light;
