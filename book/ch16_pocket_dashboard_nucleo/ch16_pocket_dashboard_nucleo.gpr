with "config/ch16_pocket_dashboard_nucleo_config.gpr";
with "runtime_build.gpr";
with "keel_core.gpr";
with "keel_cli.gpr";
with "keel_drivers.gpr";
with "keel_log.gpr";
with "keel_stm32g4.gpr";
with "keel_stm32g4_svd.gpr";
with "keel_ui.gpr";

project Ch16_Pocket_Dashboard_Nucleo is
   for Target use Runtime_Build'Target;
   for Runtime ("Ada") use Runtime_Build'Runtime ("Ada");

   --  The Pico project's shell, scene, main loop and commands; the
   --  board and the display are new
   for Source_Dirs use
     ("../ch15_keelsh/src/common/",
      "../ch16_pocket_dashboard/src/scene/",
      "../ch16_pocket_dashboard/src/common/", "src/", "config/");
   for Excluded_Source_Files use ("keelsh.adb");
   for Object_Dir use
     "obj/" & Ch16_Pocket_Dashboard_Nucleo_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("pocket_dashboard.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Ch16_Pocket_Dashboard_Nucleo_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-ffunction-sections", "-fdata-sections");
      for Local_Configuration_Pragmas use "gnat.adc";
   end Compiler;

   package Linker is
      for Switches ("Ada") use
        Keel_STM32G4.Linker_Switches & ("-Wl,--gc-sections");
   end Linker;
end Ch16_Pocket_Dashboard_Nucleo;
