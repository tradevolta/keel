with "config/ch01_hello_photon_config.gpr";
with "runtime_build.gpr";

project Ch01_Hello_Photon is
   for Target use Runtime_Build'Target;
   for Runtime ("Ada") use Runtime_Build'Runtime ("Ada");

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use
     "obj/" & Ch01_Hello_Photon_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("hello_photon.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Ch01_Hello_Photon_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-ffunction-sections", "-fdata-sections");
   end Compiler;

   package Linker is
      for Switches ("Ada") use
        Runtime_Build.Linker_Switches &
        ("-Wl,--gc-sections",
         "-Wl,-Map=" & Project'Project_Dir & "bin/hello_photon.map");
   end Linker;
end Ch01_Hello_Photon;
