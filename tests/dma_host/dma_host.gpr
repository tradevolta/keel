with "config/dma_host_config.gpr";

project DMA_Host is
   for Source_Dirs use
     ("src/", "config/", "../../book/ch12_logic_sampler/src/shared/");
   for Object_Dir use "obj/" & DMA_Host_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("dma_host.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        DMA_Host_Config.Ada_Compiler_Switches & ("-gnat2022");
   end Compiler;
end DMA_Host;
