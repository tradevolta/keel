with "config/adc_host_config.gpr";

project ADC_Host is
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & ADC_Host_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("adc_host.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ADC_Host_Config.Ada_Compiler_Switches & ("-gnat2022");
   end Compiler;
end ADC_Host;
