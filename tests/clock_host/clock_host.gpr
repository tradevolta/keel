with "config/clock_host_config.gpr";

project Clock_Host is
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Clock_Host_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("clock_host.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Clock_Host_Config.Ada_Compiler_Switches & ("-gnat2022");
   end Compiler;
end Clock_Host;
