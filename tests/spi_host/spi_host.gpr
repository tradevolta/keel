--  SPDX-License-Identifier: Apache-2.0
--  spi_host: Chapter 16's tests on the host, with the dashboard's
--  scene from book/ch16_pocket_dashboard/src/scene/ drawn on a
--  model of the ST7789 behind a fake SPI bus.
with "config/spi_host_config.gpr";
with "keel_core.gpr";
with "keel_drivers.gpr";
with "keel_host.gpr";
with "keel_ui.gpr";

project SPI_Host is
   for Source_Dirs use
     ("src/", "config/", "../../book/ch16_pocket_dashboard/src/scene/");
   for Object_Dir use "obj/" & SPI_Host_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("spi_host.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        SPI_Host_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnata");
   end Compiler;
end SPI_Host;
