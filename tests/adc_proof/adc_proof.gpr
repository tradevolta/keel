--  SPDX-License-Identifier: Apache-2.0
--  The converters' arithmetic, straight from keel_core's sources:
--  gnatprove proves every unit of this project.
project ADC_Proof is
   for Source_Dirs use ("../../crates/keel_core/src/");
   for Source_Files use
     ("keel.ads", "keel-units.ads", "keel-units.adb", "keel-pwm.ads",
      "keel-pwm.adb", "keel-adc.ads", "keel-adc.adb",
      "keel-adc-chip_limits.ads", "keel-dac.ads", "keel-dac.adb");
   for Object_Dir use "obj/";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=2", "--checks-as-errors=on");
   end Prove;
end ADC_Proof;
