with "config/gpio_host_config.gpr";
with "keel_host.gpr";

project GPIO_Host is
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & GPIO_Host_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("gpio_host.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        GPIO_Host_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-gnata");
   end Compiler;
end GPIO_Host;
