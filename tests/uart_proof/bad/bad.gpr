--  SPDX-License-Identifier: Apache-2.0
--  Two pieces of code that break the ring's rules: a Pop with a bug,
--  under the real specification, and a caller that pops without
--  asking. gnatprove must reject both.
project Bad is
   --  keel-ring_buffers.adb is found here first, the .ads in keel_core
   for Source_Dirs use (".", "../../../crates/keel_core/src/");
   for Source_Files use
     ("keel.ads", "keel-ring_buffers.ads", "keel-ring_buffers.adb",
      "careless.ads", "careless.adb");
   for Object_Dir use "obj/";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=2", "-A=info-unrolling-inlining");
   end Prove;
end Bad;
