with "config/units_host_config.gpr";

project Units_Host is
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Units_Host_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("units_host.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Units_Host_Config.Ada_Compiler_Switches & ("-gnat2022");
   end Compiler;
end Units_Host;
