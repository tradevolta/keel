with "config/power_host_config.gpr";

project Power_Host is
   for Source_Dirs use
     ("src/", "config/",
      "../../book/ch14_sleepy_sentinel/src/shared/",
      "../power_proof/src/");
   for Object_Dir use "obj/" & Power_Host_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("power_host.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Power_Host_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnata");
   end Compiler;
end Power_Host;
