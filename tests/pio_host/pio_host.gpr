with "config/pio_host_config.gpr";

project PIO_Host is
   for Source_Dirs use
     ("src/", "config/", "../../book/ch13_thermo_strip/src/shared/");
   for Object_Dir use "obj/" & PIO_Host_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("pio_host.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        PIO_Host_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnata");
   end Compiler;
end PIO_Host;
